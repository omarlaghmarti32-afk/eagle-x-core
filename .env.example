EAGLE_API_TOKEN=replace-with-long-random-secret-32chars
EAGLE_REQUIRE_STRONG_TOKEN=1
EAGLE_LIVE_MONITOR=1
EAGLE_MONITOR_INTERVAL=2.0
EAGLE_DATA_DIR=./data
EAGLE_LOG_DIR=./logs
EAGLE_CORS_ORIGINS=*
EAGLE_PROTECT_READ_APIS=0
EAGLE_RATE_LIMIT_PER_MIN=120
EAGLE_WEBHOOK_URL=
EAGLE_WEBHOOK_FORMAT=auto
EAGLE_WEBHOOK_MIN_VOTES=3
EAGLE_WEBHOOK_ALLOW_PRIVATE=0
LOG_LEVEL=INFO
